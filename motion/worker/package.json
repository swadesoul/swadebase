{
  "name": "swadebase-motion-worker",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "SWADEBASE Motion Studio render worker: compose HyperFrames HTML, render MP4, store in Backblaze B2.",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node worker.mjs",
    "once": "node worker.mjs --once",
    "check": "node --check worker.mjs && node --check template.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "aws4fetch": "1.0.20",
    "hyperframes": "0.8.206"
  }
}
