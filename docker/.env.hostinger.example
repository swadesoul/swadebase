# SwadeBase production template for Hostinger
# Copy values into the Hostinger application's environment variables.
# Never commit real secrets.

# Public production origin
SUPABASE_PUBLIC_URL=https://swadebase.cloud
API_EXTERNAL_URL=https://swadebase.cloud/auth/v1
PROXY_DOMAIN=swadebase.cloud

# Oathloom / ecosystem auth redirects
SITE_URL=https://sssbrain.live
ADDITIONAL_REDIRECT_URLS=https://sssbrain.live/auth,https://sssbrain.live/**,https://oathloom.com/auth,https://oathloom.com/**

# Required generated secrets - set in Hostinger, never in GitHub
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=
SECRET_KEY_BASE=
VAULT_ENC_KEY=
PG_META_CRYPTO_KEY=
LOGFLARE_PUBLIC_ACCESS_TOKEN=
LOGFLARE_PRIVATE_ACCESS_TOKEN=

# Dashboard
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
STUDIO_DEFAULT_ORGANIZATION=Swade Soul
STUDIO_DEFAULT_PROJECT=SwadeBase
OPENAI_API_KEY=

# Auth
# Google OAuth - set real values in Hostinger/Coolify runtime only.
# Google Cloud Authorized redirect URI: https://swadebase.cloud/auth/v1/callback
GOOGLE_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

JWT_EXPIRY=3600
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# Email - configure a real SMTP provider in Hostinger before production email verification
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=SwadeBase

# Database / pooler
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5
POOLER_TENANT_ID=swadebase

# API gateway
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# Storage / realtime
GLOBAL_S3_BUCKET=swadebase
REGION=local
STORAGE_TENANT_ID=swadebase
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=
IMGPROXY_AUTO_WEBP=true
REALTIME_DB_ENC_KEY=supabaserealtime

# Functions
FUNCTIONS_VERIFY_JWT=false

# API
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public
