# SWADE ontology facade. Off by default.
# Set SWADE_ONTOLOGY_ENABLED=true only when an operator is ready to serve reads.

SWADE_ONTOLOGY_ENABLED=false
SWADE_ONTOLOGY_HOST=0.0.0.0
SWADE_ONTOLOGY_PORT=8090

# Isolated database. The name must be swade_ontology.
# Do not point this at the SWADEBASE platform database.
SWADE_ONTOLOGY_DATABASE_URL=postgresql://swade_ontology:change-me@swade-ontology-db:5432/swade_ontology

# Existing SWADE AI gateway. Free callers stay on the local route.
SWADE_AI_GATEWAY_URL=
SWADE_AI_GATEWAY_KEY=
SWADE_ONTOLOGY_LOCAL_MODEL=auto/offline
SWADE_ONTOLOGY_PAID_MODEL=

# Optional SSS Brain tenant search. Leave empty until that route exists.
# The token must be tenant-scoped. Do not use a service-role key.
SSS_BRAIN_SEARCH_URL=
SSS_BRAIN_READ_TOKEN=

# Optional internal engine. Leave empty to answer from the starter catalog.
SWADE_ONTOLOGY_ENGINE_URL=

# SWADEBASE auth (GoTrue). Google OAuth is configured on that service.
# This process only checks the signed-in user. Do not put a Google client secret here.
SWADEBASE_AUTH_URL=
SWADE_ONTOLOGY_OWNER_EMAIL=

# Operator session lifetimes, in seconds. Defaults: 30 days idle, 90 days absolute, 15 minutes for a fresh sign-in.
SWADE_ONTOLOGY_SESSION_IDLE_SECONDS=2592000
SWADE_ONTOLOGY_SESSION_ABSOLUTE_SECONDS=7776000
SWADE_ONTOLOGY_SESSION_REAUTH_SECONDS=900
