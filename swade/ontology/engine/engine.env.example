# Engine environment for the pinned Auto Ontology process.
# Copy to a secret store. Do not commit filled values.
# Leave KUMO_RFM_API_KEY unset. Table upload stays disabled.
# Model endpoints must be the SWADE AI gateway, not a hosted NVIDIA endpoint.

POSTGRES_HOST=swade-ontology-engine-db
POSTGRES_PORT=5432
POSTGRES_USER=swade_ontology_engine
POSTGRES_PASSWORD=
POSTGRES_DATABASE=auto_ontology

DEFAULT_MODELS_ENDPOINT=
DEFAULT_MODELS_API_KEY=
DEFAULT_MODELS_MODEL=auto/offline
REASONING_ENDPOINT=
REASONING_API_KEY=
REASONING_MODEL=auto/offline
NON_REASONING_ENDPOINT=
NON_REASONING_API_KEY=
NON_REASONING_MODEL=auto/offline
EMBED_ENDPOINT=
EMBED_API_KEY=
EMBED_MODEL=auto/offline
RERANK_ENDPOINT=
RERANK_API_KEY=
RERANK_MODEL=auto/offline

INGESTION_SERVICE_URL=http://swade-ontology-engine:3002
APP_URL=http://swade-ontology-engine:3000
AUTO_ONTOLOGY_MCP_PUBLIC_URL=
